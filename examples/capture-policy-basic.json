{
  "mode": "policy",
  "capture": {
    "prompt": {
      "allow": true,
      "maxLength": 512
    },
    "response": {
      "allow": true,
      "maxLength": 512
    },
    "model": {
      "includeProvider": true,
      "includeModelId": true
    },
    "operationalContext": {
      "allowedKeys": [
        "ticketId",
        "customerId",
        "severity",
        "source",
        "environment",
        "outcome",
        "reviewType",
        "department"
      ],
      "redactedKeys": [
        "internalNotes",
        "rawPayload",
        "debugTrace"
      ],
      "dropUnknownKeys": true,
      "maxValueLength": 128
    }
  },
  "security": {
    "neverForward": [
      "apiKey",
      "authToken",
      "sessionId",
      "password",
      "secret",
      "accessToken",
      "refreshToken"
    ],
    "logRedactions": true
  }
}
